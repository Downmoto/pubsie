{
  "name": "pubsie",
  "version": "2.0.4",
  "description": "A library to parse and build EPUB files.",
  "main": "dist/pubsie.js",
  "types": "dist/pubsie.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "test": "jest",
    "test-manual": "jest tests/manual.test.ts --testPathIgnorePatterns=\"\"",
    "build": "tsc",
    "prepare": "npm run build",
    "fmt": "prettier --write ."
  },
  "keywords": [
    "epub",
    "ebook",
    "parser",
    "reader"
  ],

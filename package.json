  "repository": {
    "type": "git",
    "url": "https://github.com/Downmoto/pubsie"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "jest": "^29.7.0",
    "jszip-utils": "^0.1.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/jest": "^29.5.14",
    "@types/xml2js": "^0.4.14",
    "prettier": "3.5.3",
    "ts-jest": "^29.3.4",
    "typescript": "^5.8.3"
  }
}
